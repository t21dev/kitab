{
  "name": "kitab-landing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Website for Kitab Reader (kitab.t21.dev). Static, prerendered, served by Cloudflare Workers static assets.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "og": "node scripts/og.mjs",
    "sync": "node scripts/sync-from-main.mjs",
    "check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "marked": "^18.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.158.0"
  }
}
