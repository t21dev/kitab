<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: AGPL-3.0-or-later
  Kitab Reader's MSIX manifest, for the Microsoft Store. tools/package_msix.py
  fills in the version (x.y.z.0: the Store keeps the fourth part for itself)
  and the architecture, and writes the file types from kitab-os's FILE_TYPES
  into Extensions.

  The Identity and PublisherDisplayName are the values Partner Center reserved
  for the product (Product management > Product identity). The Store re-signs
  the package with that publisher, so they must match exactly.

  kitab.exe is a full-trust desktop app. The manifest replaces what Kitab
  writes to the registry when it isn't packaged (kitab-os assoc.rs): the file
  types, Print, and kitab_shell.dll as Explorer's thumbnail provider. Its app
  execution alias, kitab.exe, gives terminals the kitab command (bin\kitab.exe),
  which the installer's PATH entry does otherwise.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap5 desktop desktop2 desktop4 desktop5 com rescap">

  <Identity
    Name="TriptoAfsin.KitabReader"
    Publisher="CN=83EC5113-24EF-4718-9965-289BB530FA30"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>Kitab Reader</DisplayName>
    <PublisherDisplayName>TriptoAfsin</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A fast, native reader for PDF, ebooks and Markdown.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809: the oldest that loads packaged thumbnail handlers. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Kitab" Executable="kitab.exe" EntryPoint="Windows.FullTrustApplication" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Kitab Reader"
        Description="A fast, native reader for PDF, ebooks and Markdown."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Kitab" />
      </uap:VisualElements>

      <Extensions>
        <!-- kitab_shell.dll (crate kitab-shell): IThumbnailProvider. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Kitab Reader thumbnails">
              <com:Class Id="7080945F-C214-4A8A-B62B-FC5E2E3D047E" Path="kitab_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- kitab_shell.dll: the right-click tools (IExplorerCommand), in
             Windows 11's own menu. The handler shows only what fits the
             selection (Combine for 2+ PDFs, Make a PDF for pictures...). -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Kitab Reader tools">
              <com:Class Id="5B2C9E41-7D3A-4F6E-9A1B-C8E2F0D4A713" Path="kitab_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
@CONTEXT_MENU_TYPES@
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <!-- The kitab command (crate kitab-cli) in terminals: the alias
             kitab.exe runs bin\kitab.exe, a console program. It belongs to
             this application on purpose: a second, hidden application
             (AppListEntry="none") is a "headless app" that Partner Center
             refuses without a waiver. A console alias needs
             SupportsMultipleInstances on its Application, or makeappx
             rejects the manifest; Kitab handles one-window-per-user itself. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="bin\kitab.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="kitab.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
@FILE_TYPES@
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
