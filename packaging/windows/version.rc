// SPDX-License-Identifier: AGPL-3.0-or-later
// The version block of kitab.exe. Windows shows FileDescription as the app's
// name: the print dialog's title ("Kitab - Print" instead of "Printing from
// Win32 application"), Task Manager, Open with. crates/kitab/build.rs
// defines KITAB_V1..KITAB_V3 and KITAB_VERSION from Cargo.toml.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION KITAB_V1,KITAB_V2,KITAB_V3,0
PRODUCTVERSION KITAB_V1,KITAB_V2,KITAB_V3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "t21"
            VALUE "FileDescription", "Kitab"
            VALUE "FileVersion", KITAB_VERSION
            VALUE "InternalName", "kitab"
            VALUE "LegalCopyright", "AGPL-3.0-or-later"
            VALUE "OriginalFilename", "kitab.exe"
            VALUE "ProductName", "Kitab"
            VALUE "ProductVersion", KITAB_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
