<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<!-- shared-mime-info: Markdown is missing on some distributions; Kitab's
     document icons for its types. Installed to /usr/share/mime/packages/. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/markdown">
    <comment>Markdown document</comment>
    <sub-class-of type="text/plain"/>
    <icon name="dev.t21.kitab-md"/>
    <glob pattern="*.md"/>
    <glob pattern="*.markdown"/>
    <glob pattern="*.mdown"/>
    <glob pattern="*.mkd"/>
  </mime-type>
  <mime-type type="application/pdf">
    <icon name="dev.t21.kitab-pdf"/>
  </mime-type>
  <mime-type type="application/epub+zip">
    <icon name="dev.t21.kitab-epub"/>
  </mime-type>
  <mime-type type="application/x-mobipocket-ebook">
    <icon name="dev.t21.kitab-mobi"/>
  </mime-type>
  <mime-type type="application/x-fictionbook+xml">
    <icon name="dev.t21.kitab-fb2"/>
  </mime-type>
  <mime-type type="application/vnd.comicbook+zip">
    <icon name="dev.t21.kitab-cbz"/>
  </mime-type>
  <mime-type type="application/vnd.comicbook-rar">
    <icon name="dev.t21.kitab-cbr"/>
  </mime-type>
  <!-- Missing from older shared-mime-info. -->
  <mime-type type="application/x-cb7">
    <comment>Comic book archive (7z)</comment>
    <icon name="dev.t21.kitab-cb7"/>
    <glob pattern="*.cb7"/>
  </mime-type>
  <mime-type type="image/vnd.djvu">
    <icon name="dev.t21.kitab-djvu"/>
  </mime-type>
  <mime-type type="image/vnd.djvu+multipage">
    <icon name="dev.t21.kitab-djvu"/>
  </mime-type>
  <mime-type type="application/oxps">
    <icon name="dev.t21.kitab-xps"/>
  </mime-type>
</mime-info>
