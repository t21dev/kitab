  <name>Kitab Reader</name>
  <summary>A fast, native reader for PDF, ebooks, comics and Markdown</summary>
  <developer id="dev.t21">
    <name>t21 dev</name>
  </developer>
  <description>
    <p>
      Kitab Reader opens PDF, EPUB, MOBI, FB2, CBZ, XPS, Markdown and plain
      text in one native window. Pages are drawn by MuPDF on the GPU, so big
      files open quickly and scroll smoothly.
    </p>
    <ul>
      <li>Tabs, a library with shelves and collections, and full-text search</li>
      <li>Highlights, notes, ink and shapes, saved into the PDF</li>
      <li>PDF forms, digital signatures and password-protected files</li>
      <li>Markdown with maths and Mermaid diagrams</li>
      <li>Light, sepia and dark themes, and a focus mode</li>
      <li>No telemetry: your files stay on your computer</li>
    </ul>
  </description>
  <launchable type="desktop-id">dev.t21.kitab.desktop</launchable>
  <url type="homepage">https://github.com/t21dev/kitab</url>
