[Thumbnailer Entry]
TryExec=kitab
Exec=kitab --thumbnail -s %s %i %o
MimeType=application/pdf;application/epub+zip;application/x-mobipocket-ebook;application/x-fictionbook+xml;application/vnd.comicbook+zip;application/x-cbz;application/vnd.comicbook-rar;application/x-cbr;application/x-cb7;image/vnd.djvu;image/vnd.djvu+multipage;image/x-djvu;application/oxps;application/vnd.ms-xpsdocument;text/markdown;text/x-markdown;
