<!-- Kitab.app/Contents/Info.plist. Icons come from tools/make_icons.py.
     Kitab registers as an alternate handler (LSHandlerRank Alternate): it
     never takes a type over by itself; the user picks it in Finder. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Kitab</string>
  <key>CFBundleDisplayName</key><string>Kitab Reader</string>
  <key>CFBundleIdentifier</key><string>dev.t21.kitab</string>
  <key>CFBundleExecutable</key><string>kitab</string>
  <key>CFBundleIconFile</key><string>Kitab</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>PDF document</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-pdf</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>com.adobe.pdf</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Markdown document</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>CFBundleTypeIconFile</key><string>doc-md</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>net.daringfireball.markdown</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>EPUB book</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-epub</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>org.idpf.epub-container</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>MOBI book</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-mobi</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>dev.t21.kitab.mobi</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>FictionBook</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-fb2</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>dev.t21.kitab.fb2</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Comic book archive</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-cbz</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>dev.t21.kitab.cbz</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Comic book archive (RAR)</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-cbr</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>dev.t21.kitab.cbr</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Comic book archive (7z)</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-cb7</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>dev.t21.kitab.cb7</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>DjVu document</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-djvu</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>dev.t21.kitab.djvu</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>XPS document</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-xps</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>com.microsoft.xps</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Text file</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleTypeIconFile</key><string>doc-txt</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>public.plain-text</string></array>
    </dict>
  </array>
  <!-- macOS has no system UTI for Markdown, MOBI, FB2, comics, DjVu or XPS: declare them.
       EPUB (org.idpf.epub-container) and plain text are system types. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>net.daringfireball.markdown</string>
      <key>UTTypeDescription</key><string>Markdown document</string>
      <key>UTTypeConformsTo</key><array><string>public.plain-text</string></array>
      <key>UTTypeIconFile</key><string>doc-md</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>md</string><string>markdown</string><string>mdown</string><string>mkd</string></array>
        <key>public.mime-type</key><array><string>text/markdown</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>dev.t21.kitab.mobi</string>
      <key>UTTypeDescription</key><string>MOBI book</string>
      <key>UTTypeConformsTo</key><array><string>public.data</string></array>
      <key>UTTypeIconFile</key><string>doc-mobi</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>mobi</string><string>azw</string></array>
        <key>public.mime-type</key><array><string>application/x-mobipocket-ebook</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>dev.t21.kitab.fb2</string>
      <key>UTTypeDescription</key><string>FictionBook</string>
      <key>UTTypeConformsTo</key><array><string>public.xml</string></array>
      <key>UTTypeIconFile</key><string>doc-fb2</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>fb2</string></array>
        <key>public.mime-type</key><array><string>application/x-fictionbook+xml</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>dev.t21.kitab.cbz</string>
      <key>UTTypeDescription</key><string>Comic book archive</string>
      <key>UTTypeConformsTo</key><array><string>public.zip-archive</string></array>
      <key>UTTypeIconFile</key><string>doc-cbz</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>cbz</string></array>
        <key>public.mime-type</key><array><string>application/vnd.comicbook+zip</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>dev.t21.kitab.cbr</string>
      <key>UTTypeDescription</key><string>Comic book archive (RAR)</string>
      <key>UTTypeConformsTo</key><array><string>public.data</string></array>
      <key>UTTypeIconFile</key><string>doc-cbr</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>cbr</string></array>
        <key>public.mime-type</key><array><string>application/vnd.comicbook-rar</string><string>application/x-cbr</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>dev.t21.kitab.cb7</string>
      <key>UTTypeDescription</key><string>Comic book archive (7z)</string>
      <key>UTTypeConformsTo</key><array><string>public.data</string></array>
      <key>UTTypeIconFile</key><string>doc-cb7</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>cb7</string></array>
        <key>public.mime-type</key><array><string>application/x-cb7</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>dev.t21.kitab.djvu</string>
      <key>UTTypeDescription</key><string>DjVu document</string>
      <key>UTTypeConformsTo</key><array><string>public.data</string></array>
      <key>UTTypeIconFile</key><string>doc-djvu</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>djvu</string><string>djv</string></array>
        <key>public.mime-type</key><array><string>image/vnd.djvu</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>com.microsoft.xps</string>
      <key>UTTypeDescription</key><string>XPS document</string>
      <key>UTTypeConformsTo</key><array><string>public.data</string></array>
      <key>UTTypeIconFile</key><string>doc-xps</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>xps</string><string>oxps</string></array>
        <key>public.mime-type</key><array><string>application/oxps</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
